# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Local PostgreSQL, or a Supabase connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniswap

# Any long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Where the Next.js frontend runs, so the browser is allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

# Optional: the email account that sends verification links. While SMTP_PASS is empty, no email
# is sent and the links are printed in the server log instead. Test with: npm run email:test
#   School Outlook / Microsoft 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  (your normal password)
#   Gmail:                          SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  (a Google App Password)
# Wrap the password in single quotes if it contains spaces or a # character.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@university.edu.kh
SMTP_PASS=
# Optional sender name and address; defaults to "UniSwap <SMTP_USER>".
# EMAIL_FROM=UniSwap <you@university.edu.kh>
